# Copy to .env (make up does this on first run). Synthetic, local-only values; never commit .env.

# Models (Phase 1+)
ANTHROPIC_API_KEY=
BOT_MODEL=anthropic:claude-sonnet-5-5
GUARD_MODEL=anthropic:claude-haiku-5-5
# Failover chains (ADR 018): comma-separated backups tried in order; empty means no failover.
BOT_MODEL_FALLBACKS=anthropic:claude-haiku-5-5
GUARD_MODEL_FALLBACKS=anthropic:claude-sonnet-5-5
# Orchestrator deadlines per model tried; the guards get GUARD_REQUEST_TIMEOUT_SECONDS per attempt.
LLM_FIRST_EVENT_TIMEOUT_SECONDS=10
LLM_REQUEST_TIMEOUT_SECONDS=90
GUARD_REQUEST_TIMEOUT_SECONDS=6
# Local demos and tests only, e.g. orchestrator:overloaded or primary:stall (see make failover-demo). Keep empty.
LLM_FAULT_INJECTION=

# Service ports
BFF_PORT=3000
MCP_ACCOUNTS_PORT=8101
MCP_PAYMENTS_PORT=8102
MCP_GATEWAY_PORT=8100

# Host-side port overrides, when another local stack already uses the default
# POSTGRES_HOST_PORT=5432
# REDIS_HOST_PORT=6379
# BFF_HOST_PORT=3000
# BOT_HOST_PORT=8000
# MCP_ACCOUNTS_HOST_PORT=8101
# MCP_PAYMENTS_HOST_PORT=8102
# MCP_GATEWAY_HOST_PORT=8100
# WEB_HOST_PORT=5173

# Postgres (+ pgvector)
POSTGRES_USER=bank
POSTGRES_PASSWORD=bank
POSTGRES_DB=bank

LOG_LEVEL=info

# Mock IdP (BFF) and the bot that trusts it. Docker Compose overrides these with in-network URLs.
IDP_ISSUER=http://localhost:3000
IDP_JWKS_URL=http://localhost:3000/.well-known/jwks.json
BOT_AGENT_URL=http://localhost:8000/agent
# The BFF's thread log for resumable streams (ADR 015). Docker Compose overrides it with the in-network URL.
REDIS_URL=redis://localhost:6379
COOKIE_SECURE=false
# The bot's credential at the mock IdP's token endpoint (local-only value, at least 16 characters)
BOT_CLIENT_SECRET=local-dev-bot-secret-change-me
IDP_TOKEN_URL=http://localhost:3000/token
# The MCP gateway's credential at the same endpoint (ADR 017; local-only value, at least 16 characters)
MCP_GATEWAY_CLIENT_SECRET=local-dev-gateway-secret-change-me
# The bank's calendar (containers run in UTC): the bot's "today" and open-ended periods, and the local
# days mcp-accounts filters and totals by. Compose hands both the same value through .env.
BANK_TIMEZONE=America/Argentina/Buenos_Aires

# The bot reaches every MCP tool through the gateway (ADR 017); only the gateway knows the backends.
# Docker Compose overrides these with in-network URLs.
MCP_GATEWAY_URL=http://localhost:8100/mcp
MCP_ACCOUNTS_URL=http://localhost:8101/mcp
MCP_PAYMENTS_URL=http://localhost:8102/mcp
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-mpnet-base-v2
DATABASE_URL=postgres://bank:bank@localhost:5432/bank

# Tracing to Phoenix (leave empty to disable export when running a service bare)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:6006

# Opt out of CopilotKit's anonymous usage analytics
COPILOTKIT_TELEMETRY_DISABLED=true
DO_NOT_TRACK=1
