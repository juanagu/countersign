#!/bin/sh
# Pre-push hook: the CI fast tier's cheap checks (lint, typecheck, unit tests), so a push doesn't
# fail CI on something a local run catches. Installed by scripts/install-git-hooks.mjs on install.
[ -n "$CI" ] && exit 0
top="$(git rev-parse --show-toplevel)"
[ -d "$top/node_modules" ] || { echo "pre-push: run make install first" >&2; exit 1; }
if [ -n "$(git status --porcelain)" ]; then
  echo "pre-push: note: uncommitted files present; checks run on the working tree" >&2
fi
make -C "$top" lint test || { echo "pre-push: FAILED (make lint test)" >&2; exit 1; }
